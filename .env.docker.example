# Docker Compose ortam değişkenleri.
# Bu dosyayı `.env` olarak kopyalayın (compose otomatik okur) ve değerleri doldurun.
#   cp .env.docker.example .env
# !!! .env dosyasını ASLA git'e yüklemeyin (gizli anahtarlar içerir). !!!
#   chmod 600 .env

# PostgreSQL parolası (güçlü, rastgele)
DB_PASSWORD=degistir_guclu_bir_parola

# QR + doğrulama belirteci HMAC anahtarı (en az 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=buraya_64_hex_karakterlik_gercek_anahtar

# --- Ana alan adı (SATIN ALDIĞIN DOMAIN) ---
# Belediye subdomain'leri bunun altında olur: gulsehir.<APP_BASE_DOMAIN>
# Burayı ve cloudflared/config.yml içindeki wildcard'ı AYNI domain yap.
# .com.tr gibi çok parçalı uzantılar da desteklenir (ör. belediye.com.tr).
APP_BASE_DOMAIN=sikayet.com

# --- QR yönlendirici kökü (opsiyonel) ---
# Tüm QR kodlar bu köke basılır: https://qr.<domain>/q/<id>. Boş bırakılırsa
# APP_BASE_DOMAIN'den otomatik "https://qr.<APP_BASE_DOMAIN>" türetilir.
# Bu kökü ASLA değiştirme/kapatma (basılı QR'lar buna bağlıdır).
# qr.<domain> için BİR KEZ DNS route ekle (bkz. DEPLOY.md 6.5).
# QR_BASE_URL=https://qr.sikayet.com

# --- Şikayet limiti (opsiyonel; test/demo için) ---
# Aynı kişi (SMS-only modda doğrulanmış TELEFON; NVİ açıkken ad+soyad+doğum+telefon)
# bir pencere içinde kaç şikayet gönderebilir.
# Boş/tanımsız → kod varsayılanı: 1 hafta içinde 1 şikayet.
# TEST için: SIKAYET_HAFTALIK_ADET=7 (pencere içinde 7'ye kadar ART ARDA gönderim).
# Hızlı ard arda test için pencereyi de kısalt: SIKAYET_BEKLEME_MS=60000 (1 dk).
# Testten sonra bu satırları SİL (ya da SIKAYET_HAFTALIK_ADET=1) ve `docker compose up -d --build`.
# SIKAYET_HAFTALIK_ADET=1
# SIKAYET_BEKLEME_MS=604800000

# --- Netgsm SMS (gerçek SMS göndermek için ZORUNLU) ---
# Boş bırakılırsa MockSmsProvider devreye girer ve ÜRETİMDE HİÇ SMS GİTMEZ.
NETGSM_USERCODE=netgsm_kullanici_kodu
NETGSM_PASSWORD=netgsm_api_sifresi
NETGSM_HEADER=ONAYLI_BASLIK

# --- Cloudflare R2 (şikayet fotoğrafları için) ---
# Boş bırakılırsa fotoğraf yükleme sessizce kapalı kalır (şikayet yine çalışır).
# Bucket PRIVATE olmalı; fotoğraflar yalnızca başkanın yetkili route'undan servis edilir.
# Kurulum için bkz. DEPLOY.md 10.1.
R2_ACCOUNT_ID=cloudflare_account_id
R2_ACCESS_KEY_ID=r2_access_key
R2_SECRET_ACCESS_KEY=r2_secret_key
R2_BUCKET=belediye-foto

# --- Cloudflare Tunnel (uzaktan-yönetilen, token ile) ---
# Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared akışında verilen
# token. Ingress kuralları (hostname → servis) dashboard'da tutulur; sunucuda ayrı
# bir config.yml/credentials dosyası GEREKMEZ. Bkz DEPLOY.md.
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
